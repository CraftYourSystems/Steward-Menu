# Names only — never commit values. Copy to .env.local for development.
# `next dev`, `next build` and `next start` refuse to run while the value is
# missing or malformed (src/lib/env.ts).

# Required. FastAPI base URL used by browser requests. Inlined at build time.
# Include the API prefix: every path the app calls (e.g. /customer/menu) is relative to it.
#   Local FastAPI:  http://localhost:8000/api/v1   (README.md, "Local development")
#   Mock API:       http://localhost:8788          (`pnpm mock:api`; no /api/v1)
NEXT_PUBLIC_API_BASE_URL=
